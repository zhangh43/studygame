DATABASE_URL=postgres://game_studio:change-me@localhost:5433/game_studio
POSTGRES_PASSWORD=change-me
POSTGRES_MAX_CONNECTIONS=100
DB_POOL_MAX=30
APP_PORT=3000
APP_BIND_ADDRESS=0.0.0.0
DB_PORT=5433
APP_URL=http://localhost:3000
# Required for the optional Caddy HTTPS profile, for example games.example.com.
DOMAIN=localhost
SESSION_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
# Optional: required instead when your mounted Codex config uses Azure OpenAI.
AZURE_OPENAI_API_KEY=
# Optional local provider configuration. Container session state remains separate.
CODEX_CONFIG_PATH=./docker/codex-config.toml
WORKSPACE_ROOT=./data/workspaces
PUBLISHED_ROOT=./data/published
HARNESS_PROVIDER=codex
CODEX_MODEL=
CODEX_REASONING_EFFORT=low
HARNESS_MAX_CONCURRENCY=4
